                "strategy": "feedback_gated",
                "lookback_sessions": 5,
                "min_successful_sessions": 2,
                "required_feedback": [
                    "easy",
                    "comfortable"
                ]
            },
            "safety_considerations": [
                "Never suggest cutting down instead of seeking evidence-based cessation care.",
                "Avoid blame or moralising language.",
                "Signpost professional cessation support and approved medication."
            ],
            "clinical_basis": "WHO 2024 tobacco-cessation guidance and USPHS treat urge surfing and delaying the next cigarette as practical behavioural supports alongside pharmacotherapy and counselling. A five-minute delay is a coping step, not a substitute for cessation treatment. (WHO 2024; USPHS 2008)",
            "limits": "General cessation support, not medical treatment. Combining counselling with approved cessation medication is most effective. Seek clinical advice if you are pregnant or have heart or lung disease.",
            "active": true
