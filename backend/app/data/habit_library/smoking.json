                    "bct_id": "8.2",
                    "implementation": "Suggest a five-minute alternative action when an urge appears.",
                    "delivery_method": "behaviour_substitution"
                },
                {
                    "bct_id": "11.2",
                    "implementation": "Offer a short grounding exercise during the delay.",
                    "delivery_method": "stress_management"
                },
                {
                    "bct_id": "1.4",
                    "implementation": "Help the user choose where and how they will use the delay.",
                    "delivery_method": "interactive_planning"
