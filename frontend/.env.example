# Backend API base URL. Leave empty to use the Vite dev proxy.
VITE_API_BASE_URL=

# Set to "true" to load movement habits and progression decisions from the
# FastAPI backend. When false (the default), the local actions catalog is used.
VITE_USE_BACKEND_PROGRESSION=true

# Set to "true" to store the journey on the FastAPI backend and sync changes
# across devices. When false (the default), the journey stays in localStorage.
VITE_USE_BACKEND_JOURNEY=false
